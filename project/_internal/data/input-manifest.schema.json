{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "defaults", "items"],
  "properties": {
    "version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "defaults": {
      "type": "object",
      "required": ["mode", "safety_mode", "target_bytes", "ocr"],
      "properties": {
        "mode": { "enum": ["auto", "high-quality", "standard", "minimum-size"] },
        "safety_mode": { "enum": ["Safe", "Warn", "Off"] },
        "target_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "ocr": { "type": "object", "required": ["enabled", "languages"], "properties": { "enabled": { "type": "boolean" }, "languages": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["input_path"],
        "properties": {
          "input_path": { "type": "string" },
          "mode": { "type": ["string", "null"], "enum": ["auto", "high-quality", "standard", "minimum-size", null] },
          "safety_mode": { "type": ["string", "null"], "enum": ["Safe", "Warn", "Off", null] },
          "target_bytes": { "type": ["integer", "null"], "minimum": 1 },
          "ocr": { "type": ["object", "null"], "properties": { "enabled": { "type": "boolean" }, "languages": { "type": "array", "items": { "type": "string" } } } },
          "output_root": { "type": ["string", "null"] },
          "allow_signed_pdf": { "type": "boolean" },
          "allow_full_page_raster": { "type": "boolean" }
        }
      }
    },
    "risk_consent": {
      "type": "object",
      "required": ["nonce", "work_dir"],
      "properties": {
        "nonce": { "type": "string", "pattern": "^[0-9a-fA-F]{32,}$" },
        "work_dir": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
