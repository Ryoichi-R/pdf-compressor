{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PDF Compressor ARM64 native benefit receipt",
    "type": "object",
    "required": [
        "schemaVersion",
        "status",
        "runtime",
        "corpus",
        "warmupCount",
        "trialCount",
        "trials",
        "thresholdEvaluation"
    ],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": { "const": 1 },
        "status": { "enum": ["measured", "not-evaluated", "failed"] },
        "runtime": { "enum": ["win-x64", "win-arm64"] },
        "host": { "type": "object" },
        "corpus": {
            "type": "object",
            "required": ["path", "fileCount", "sha256"],
            "additionalProperties": false,
            "properties": {
                "path": { "type": "string", "minLength": 1 },
                "fileCount": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
        },
        "warmupCount": { "type": "integer", "minimum": 0 },
        "trialCount": { "type": "integer", "minimum": 1 },
        "strategy": { "type": "string", "minLength": 1 },
        "trials": { "type": "array", "minItems": 1 },
        "thresholdEvaluation": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
                "status": { "enum": ["not-evaluated", "pass", "fail"] },
                "thresholdId": { "type": "string" },
                "reason": { "type": "string" }
            }
        },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
    }
}
